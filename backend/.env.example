# ========================================
# CONFIGURATION ENVIRONNEMENT - CHU YAOUNDÉ
# Copiez ce fichier en .env et remplissez les valeurs
# ========================================

NODE_ENV=development
PORT=5000

# ⚠️ OBLIGATOIRE: Votre URI MongoDB Atlas (en ligne)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://chu_admin:VOTRE_MOT_DE_PASSE@chu-yaounde.ivr9yw9.mongodb.net/chu_yaounde?retryWrites=true&w=majority&appName=CHU-Yaounde

JWT_SECRET=ChangezCeSecretEnProduction_MinimumIdem64Caractères!
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# CORS: ajoutez votre domaine de production si déployé
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# EMAIL (optionnel - pour notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=votre-email@gmail.com
EMAIL_PASSWORD=votre_mot_de_passe_app_gmail
EMAIL_FROM=noreply@chuyaounde.cm
EMAIL_FROM_NAME=CHU Yaoundé

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

ADMIN_EMAIL=admin@chuyaounde.cm
ADMIN_DEFAULT_PASSWORD=Admin@2024Change

MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

EMERGENCY_PHONE=119
BCRYPT_ROUNDS=10
SESSION_SECRET=chu_yaounde_session_secret_changez_moi_2024
